# Kai War Room brain server — env vars
# Copy to .env (or set on Railway) for local dev.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Shared bearer token between frontend and brain. Frontend sends as
# Authorization: Bearer <token>. Generate with: openssl rand -hex 32
BRAIN_TOKEN=

# Comma-separated origins allowed by CORS. Defaults cover localhost dev
# and the production War Room.
ALLOWED_ORIGINS=http://localhost:3000,https://kai-warroom.vercel.app

# Override defaults if you want.
KAI_MODEL=claude-opus-4-7
TTS_MODEL=tts-1
TTS_VOICE=onyx
